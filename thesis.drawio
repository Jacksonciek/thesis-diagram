        <mxCell id="bkX14tGxzCMUlg6iWOZ1-55" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung Evaluasi Metrik Sentence Level&lt;div&gt;&lt;div&gt;P = TP/(TP+FP);&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;R = TP/(TP+FN);&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;F1 = 2PR/(P+R);&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Acc = (TP+TN)/N; AUC-ROC&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
