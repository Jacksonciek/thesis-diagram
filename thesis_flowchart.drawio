          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AM_bkX14tGxzCMUlg6iWOZ1-15" parent="AM_zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung Query, Key, Value&lt;/b&gt;&lt;div&gt;&lt;b&gt;(Proyeksi Linear Q, K, V)&lt;/b&gt;&lt;div&gt;$$\mathbf{Q}_i=\mathbf{X}\mathbf{W}^Q_i,\;\mathbf{K}_i=\mathbf{X}\mathbf{W}^K_i,\;\mathbf{V}_i=\mathbf{X}\mathbf{W}^V_i$$&lt;/div&gt;&lt;div&gt;$$\mathbf{W}^Q,\mathbf{W}^K,\mathbf{W}^V\in\mathbb{R}^{H\times d_k},\;d_k=64$$&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="-531" y="597" as="geometry" />
        </mxCell>
        <mxCell id="AM_bkX14tGxzCMUlg6iWOZ1-17" parent="AM_zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Scaled Dot-Product Self-Attention + ALiBi Bias&lt;/b&gt;&lt;div&gt;$$\text{Attn}(\mathbf{Q},\mathbf{K},\mathbf{V})=\text{softmax}\!\left(\dfrac{\mathbf{Q}\mathbf{K}^\top}{\sqrt{d_k}}+\mathbf{m}_i\right)\mathbf{V}$$&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="-256" y="597" as="geometry" />
        </mxCell>
        <mxCell id="th-bFXFDux1spG7MHO1d-15" edge="1" parent="AM_zKPpLaLFamryoCotQF_W-1" source="AM_bkX14tGxzCMUlg6iWOZ1-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="AM_bkX14tGxzCMUlg6iWOZ1-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AM_bkX14tGxzCMUlg6iWOZ1-19" parent="AM_zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung Multi-Head Attention&lt;/b&gt;&lt;div&gt;$$\text{MultiHead}=\text{Concat}(\text{head}_1,\ldots,\text{head}_h)\mathbf{W}^O$$&lt;/div&gt;&lt;div&gt;$$\text{head}_i=\text{Attn}(\mathbf{Q}_i,\mathbf{K}_i,\mathbf{V}_i)$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="270" x="-236" y="730" as="geometry" />
        </mxCell>
        <mxCell id="th-bFXFDux1spG7MHO1d-17" edge="1" parent="AM_zKPpLaLFamryoCotQF_W-1" source="AM_bkX14tGxzCMUlg6iWOZ1-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="AM_bkX14tGxzCMUlg6iWOZ1-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AM_bkX14tGxzCMUlg6iWOZ1-21" parent="AM_zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung Feed-Forward Network (GeLU)&lt;/b&gt;&lt;div&gt;$$\text{FFN}(\mathbf{x})=\text{GeLU}(\mathbf{x}\mathbf{W}_1+\mathbf{b}_1)\mathbf{W}_2+\mathbf{b}_2$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="249" x="-505" y="730" as="geometry" />
        </mxCell>
        <mxCell id="AM_bkX14tGxzCMUlg6iWOZ1-23" parent="AM_zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung Masked Mean Pooling (Sentence Head)&lt;/b&gt;&lt;div&gt;$$\mathbf{p}=\text{Dropout}\!\left(\dfrac{\sum_i\mathbf{h}_i\cdot m_i}{\sum_i m_i+\varepsilon}\right)$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="180" x="-706" y="730" as="geometry" />
        </mxCell>
        <mxCell id="th-bFXFDux1spG7MHO1d-20" edge="1" parent="AM_zKPpLaLFamryoCotQF_W-1" source="AM_bkX14tGxzCMUlg6iWOZ1-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="AM_bkX14tGxzCMUlg6iWOZ1-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AM_bkX14tGxzCMUlg6iWOZ1-24" parent="AM_zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung&amp;nbsp;Proyeksi Klasifikasi Kalimat (Linear Head)&lt;/b&gt;&lt;div&gt;$$\mathbf{z}=\mathbf{p}\mathbf{W}_{sent}+\mathbf{b}_{sent}$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="87" width="140" x="-706" y="843" as="geometry" />
        </mxCell>
        <mxCell id="C8FDI5ozcwqpNzJ44r2u-1" edge="1" parent="AM_zKPpLaLFamryoCotQF_W-1" source="AM_bkX14tGxzCMUlg6iWOZ1-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="th-bFXFDux1spG7MHO1d-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AM_bkX14tGxzCMUlg6iWOZ1-27" parent="AM_zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung&amp;nbsp;&lt;/b&gt;&lt;strong&gt;Probabilitas Kelas Kalimat (Softmax)&lt;/strong&gt;&lt;div&gt;$$P(y=k\mid\mathbf{x})=\dfrac{e^{z_k}}{\sum_j e^{z_j}}$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="87" width="260" x="-536" y="843" as="geometry" />
        </mxCell>
        <mxCell id="C8FDI5ozcwqpNzJ44r2u-3" edge="1" parent="AM_zKPpLaLFamryoCotQF_W-1" source="AM_bkX14tGxzCMUlg6iWOZ1-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="th-bFXFDux1spG7MHO1d-25">
          <mxGeometry relative="1" as="geometry" />
