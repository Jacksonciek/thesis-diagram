        <mxCell id="bkX14tGxzCMUlg6iWOZ1-45" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung AdamW Optimizer&lt;div&gt;&lt;div&gt;m_t = beta1*m_{t-1} + (1-beta1)*g_t&lt;/div&gt;&lt;div&gt;&amp;nbsp; v_t = beta2*v_{t-1} + (1-beta2)*g_t^2&lt;/div&gt;&lt;div&gt;&amp;nbsp; m_hat = m_t / (1 - beta1^t)&lt;/div&gt;&lt;div&gt;&amp;nbsp; v_hat = v_t / (1 - beta2^t)&lt;/div&gt;&lt;div&gt;&amp;nbsp; theta_t = theta_{t-1} - lr*(m_hat/(sqrt(v_hat)+eps) + lambda*theta)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="960" y="550" as="geometry" />
        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-50" edge="1" parent="zKPpLaLFamryoCotQF_W-1" source="bkX14tGxzCMUlg6iWOZ1-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="bkX14tGxzCMUlg6iWOZ1-49">
