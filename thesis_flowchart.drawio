        <mxCell id="bkX14tGxzCMUlg6iWOZ1-17" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Scaled Dot-Product Self-Attention + ALiBi&lt;/b&gt;&lt;div&gt;$$\text{Attn}(\mathbf{Q},\mathbf{K},\mathbf{V})=\text{softmax}\!\left(\dfrac{\mathbf{Q}\mathbf{K}^\top}{\sqrt{d_k}}+\mathbf{m}_i\right)\mathbf{V}$$&lt;/div&gt;&lt;div&gt;$$(\mathbf{m}_i)_{jk}=-s_i\cdot|j-k|$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="270" x="40" y="250" as="geometry" />
