        <mxCell id="bkX14tGxzCMUlg6iWOZ1-33" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung Label Smoothing Cross-Entropy&lt;div&gt;&lt;div&gt;y_tilde_k = (1-eps)*I(k=y_true) + eps/K&lt;/div&gt;&lt;div&gt;&amp;nbsp;L_sent = -sum_k y_tilde_k * log P(y=k|x)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="250" x="40" y="350" as="geometry" />
        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-39" edge="1" parent="zKPpLaLFamryoCotQF_W-1" source="bkX14tGxzCMUlg6iWOZ1-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="bkX14tGxzCMUlg6iWOZ1-38">
