        <mxCell id="bkX14tGxzCMUlg6iWOZ1-47" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung Linear Warmup Scheduler&lt;div&gt;&lt;div&gt;lr(t) = lr_max * t/T_warm&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;jika t &amp;lt;= T_warm&lt;/div&gt;&lt;div&gt;lr(t) decay linear ke 0&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;jika t &amp;gt; T_warm&lt;/div&gt;&lt;/div&gt;" vertex="1">
