        <mxCell id="bkX14tGxzCMUlg6iWOZ1-29" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung CRF Emission Scores (Token Head)&lt;/b&gt;&lt;div&gt;$$\mathbf{e}_t=\text{Dropout}(\mathbf{h}_t)\mathbf{W}_{token}+\mathbf{b}_{token},\;\mathbf{W}_{token}\in\mathbb{R}^{H\times 3}$$&lt;/div&gt;" vertex="1">
