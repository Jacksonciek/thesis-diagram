        <mxCell id="bkX14tGxzCMUlg6iWOZ1-43" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung Gradient Clipping&lt;div&gt;g_t = g_t / max(1, norm(g_t) / tau),&amp;nbsp; tau = 1,0;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="960" y="450" as="geometry" />
        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-48" edge="1" parent="zKPpLaLFamryoCotQF_W-1" source="bkX14tGxzCMUlg6iWOZ1-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="bkX14tGxzCMUlg6iWOZ1-47">
