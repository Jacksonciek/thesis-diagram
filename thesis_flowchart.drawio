        <mxCell id="bkX14tGxzCMUlg6iWOZ1-19" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;Hitung Multi-Head Attention&lt;/b&gt;&lt;div&gt;$$\text{MultiHead}=\text{Concat}(\text{head}_1,\ldots,\text{head}_h)\mathbf{W}^O$$&lt;/div&gt;&lt;div&gt;$$\text{head}_i=\text{Attn}(\mathbf{Q}_i,\mathbf{K}_i,\mathbf{V}_i)$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="310" x="340" y="250" as="geometry" />
        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-25" edge="1" parent="zKPpLaLFamryoCotQF_W-1" source="bkX14tGxzCMUlg6iWOZ1-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="bkX14tGxzCMUlg6iWOZ1-23">
