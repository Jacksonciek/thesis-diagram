        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-34" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung CRF Loss&lt;div&gt;&lt;div&gt;L_CRF = -[score(y,x) - log Z(x)]&lt;/div&gt;&lt;div&gt;log Z(x) = log sum_{y&#39;} exp(score(y&#39;,x))&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="250" x="40" y="450" as="geometry" />
        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-42" edge="1" parent="zKPpLaLFamryoCotQF_W-1" source="bkX14tGxzCMUlg6iWOZ1-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="bkX14tGxzCMUlg6iWOZ1-40">
