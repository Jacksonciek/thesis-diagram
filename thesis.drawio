        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-38" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung Token Class Weights&lt;div&gt;L_aux = -1/|V| * sum_{t in V} w_{y_t} * sum_k y_tilde_{k,t} * log p_hat(k|t)&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="250" x="330" y="450" as="geometry" />
        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-44" edge="1" parent="zKPpLaLFamryoCotQF_W-1" source="bkX14tGxzCMUlg6iWOZ1-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="bkX14tGxzCMUlg6iWOZ1-43">
