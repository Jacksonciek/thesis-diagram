        <mxCell id="bkX14tGxzCMUlg6iWOZ1-30" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung CRF Sequence Scores untuk token head&lt;div&gt;score(y,x) = sum_t e_t[y_t] + sum_t T[y_{t-1},y_t]&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="210" x="320" y="350" as="geometry" />
        </mxCell>
        <mxCell id="bkX14tGxzCMUlg6iWOZ1-37" edge="1" parent="zKPpLaLFamryoCotQF_W-1" source="bkX14tGxzCMUlg6iWOZ1-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="bkX14tGxzCMUlg6iWOZ1-34">
