        <mxCell id="bkX14tGxzCMUlg6iWOZ1-40" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hitung kombinasi loss MTL&lt;div&gt;L_total = alpha * L_sent + beta * L_CRF + gamma * L_aux&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="610" y="450" as="geometry" />
