        <mxCell id="bkX14tGxzCMUlg6iWOZ1-51" parent="zKPpLaLFamryoCotQF_W-1" style="rounded=1;whiteSpace=wrap;html=1;" value="Kalibrasi Threshold Optimal&lt;div&gt;&lt;div&gt;theta* = argmax_theta F1(theta),&amp;nbsp; theta in [0,1]&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;theta* = 0,4429 (ditemukan pada Val Set);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
